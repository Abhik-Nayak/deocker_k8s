# Amazon RDS PostgreSQL (ap-south-1). Replace the host with your RDS endpoint
# and [YOUR-PASSWORD] with the master password.
# TLS is handled in src/db/pool.ts for any non-localhost host.
DATABASE_URL=postgresql://shortenadmin:[YOUR-PASSWORD]@shorten-url-db.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/shortenurl

# Must be identical to auth-server's JWT_SECRET.
JWT_SECRET=super-secret-change-me

PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
