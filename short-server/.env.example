# Local Postgres - must be the SAME database auth-server points at.
#   docker run -d --name shorten-pg -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17-alpine
# TLS is enabled automatically in src/db/pool.ts for any non-localhost host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Must be identical to auth-server's JWT_SECRET.
JWT_SECRET=super-secret-change-me

PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
