# Local Postgres. Nothing is provisioned in this repo - bring your own, e.g.
#   docker run -d --name shorten-pg -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17-alpine
# For managed Postgres (RDS et al.) use its endpoint and add ?sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Must be identical to short-server's JWT_SECRET.
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_MINUTES=1440
