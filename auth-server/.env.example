# Amazon RDS PostgreSQL (ap-south-1). Replace the host with your RDS endpoint
# and [YOUR-PASSWORD] with the master password.
# sslmode=require is needed - RDS presents a TLS certificate.
DATABASE_URL=postgresql://shortenadmin:[YOUR-PASSWORD]@shorten-url-db.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/shortenurl?sslmode=require

# Must be identical to short-server's JWT_SECRET.
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_MINUTES=1440
